{
    "name": "keepplain-plugin",
    "private": true,
    "type": "module",
    "description": "KeepPlain plugin for Claude Code, Codex, Cursor and Pi: send a session to KeepPlain as a draft Build.",
    "keywords": [
        "pi-package"
    ],
    "pi": {
        "extensions": [
            "./pi/extensions/keepplain.js"
        ]
    },
    "license": "MIT",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "test": "node --import ./test/isolate.mjs --test",
        "build": "node scripts/build.mjs",
        "test:binary": "node scripts/smoke.mjs",
        "test:live": "node --test --test-concurrency=1 live/*.live.mjs"
    }
}
